# ─────────────────────────────────────────────────────────────────────────────
# DSCommerce Frontend — environment variables
# Copy this file to .env.local and fill in the values
# ─────────────────────────────────────────────────────────────────────────────

# Spring Boot API base URL
# Production (Render.com):
NEXT_PUBLIC_API_URL=https://project-spring-boot-dscommerce.onrender.com

# Local development:
# NEXT_PUBLIC_API_URL=http://localhost:8080

# ─── OAuth2 Client credentials ────────────────────────────────────────────────
# Defined in application.properties → spring.security.oauth2.authorizationserver
# These are used in authService.ts to obtain the JWT token (password grant)
NEXT_PUBLIC_OAUTH_CLIENT_ID=myclient
NEXT_PUBLIC_OAUTH_CLIENT_SECRET=myclient123

# ─── Development test accounts (import.sql seed data) ────────────────────────
#
# ROLE_CLIENT (regular user):
#   email:    maria@gmail.com
#   password: 123456
#
# ROLE_ADMIN + ROLE_CLIENT (administrator — has access to /admin):
#   email:    matcamp1981@gmail.com
#   password: 123456
#
# Note: passwords in the database are bcrypt-hashed.
# The plain-text password above is what you type in the login form.
